# --- Core ---
NODE_ENV=development
PORT=3000
# Public origin. Everything (MCP, OAuth, web app, invoice pages) is served from this origin by default.
BASE_URL=http://localhost:3000
# Override individual surfaces if you split them across subdomains in production.
# MCP_URL=https://mcp.yourdomain.com/mcp
# AUTH_ISSUER_URL=https://auth.yourdomain.com
# APP_URL=https://app.yourdomain.com
DATABASE_URL=postgres://tally:tally@localhost:5433/tally
# 32+ random bytes, used to sign session cookies and magic links. `openssl rand -hex 32`
SESSION_SECRET=change-me-change-me-change-me-change-me

# --- Identity (the OAuth consent screen IS signup) ---
# Continue with Google (OIDC). Redirect URI: ${BASE_URL}/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Magic links are emailed via Resend. Without a key, links are printed to the server log (dev only).
RESEND_API_KEY=
EMAIL_FROM="Tally <invoices@yourdomain.com>"

# --- Stripe ---
# Billing (your subscriptions) and client payments (payment links).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
# Optional: platform fee in basis points on Connect payment links (0 = none)
STRIPE_CONNECT_FEE_BPS=0

# --- Product ---
PRODUCT_NAME=Tally
SUPPORT_EMAIL=support@yourdomain.com
