# --- Core ---
NODE_ENV=development
PORT=3000
# Public origin. Everything (MCP, OAuth, web app, invoice pages) is served from this origin by default.
BASE_URL=http://localhost:3000
# Production: BASE_URL=https://withtallied.com
# Override individual surfaces if you split them across subdomains in production.
# MCP_URL=https://mcp.withtallied.com/mcp
# AUTH_ISSUER_URL=https://auth.withtallied.com
# APP_URL=https://app.withtallied.com
DATABASE_URL=postgres://tally:tally@localhost:5433/tally
# Schema to use inside that database. Lets Tallied share a Postgres instance with other apps.
DATABASE_SCHEMA=tallied
# 32+ random bytes, used to sign session cookies and magic links. `openssl rand -hex 32`
SESSION_SECRET=change-me-change-me-change-me-change-me

# --- Identity (the OAuth consent screen IS signup) ---
# Continue with Google (OIDC). Redirect URI: ${BASE_URL}/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Email: set ONE of these. Without either, emails are printed to the server log (dev only).
# Any SMTP provider (Brevo free tier allows a custom domain): smtps://LOGIN:SMTP_KEY@smtp-relay.brevo.com:465
SMTP_URL=
# ...or Resend's HTTP API
RESEND_API_KEY=
EMAIL_FROM="Tallied <invoices@withtallied.com>"

# --- Directory reviewers ---
# Lets Anthropic/OpenAI reviewers sign in to ONE seeded account with a code instead of a mailbox.
# Seed the account first: node dist/scripts/seed.js reviewer@withtallied.com
# Code must be 16+ chars: `openssl rand -base64 24`. Remove both after review to disable.
REVIEWER_EMAIL=
REVIEWER_ACCESS_CODE=

# --- Stripe ---
# Billing (your subscriptions) and client payments (payment links).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
# Optional: platform fee in basis points on Connect payment links (0 = none)
STRIPE_CONNECT_FEE_BPS=0

# --- Product ---
PRODUCT_NAME=Tallied
SUPPORT_EMAIL=support@withtallied.com
